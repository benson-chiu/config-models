       +--ro resource                       string
       +--ro otn-interface-type             otn-interface-enum
       +--ro otn-interface-tcm-layer?       uint8
       +--ro otn-interface-tcm-direction?   org-openroadm-otn-common-types:tcm-direction-enum
       +--ro tti-info
          +--ro accepted-sapi?       string
          +--ro accepted-dapi?       string
          +--ro accepted-operator?   string

module: org-openroadm-otn-network-topology

  augment /nd:networks/nd:network/nd:node:
    +--rw tp-bandwidth-sharing
    |  +--rw tp-bandwidth-sharing* [tp-sharing-id]
    |     +--rw tp-sharing-id         uint16
    |     +--rw tp-list*              nwt:tp-id
    |     +--rw shared-bandwidth?     uint16
    |     +--rw possible-tp-config* [config-id]
    |        +--rw config-id            uint16
    |        +--rw tp-if-type-config* [tp-name]
    |           +--rw tp-name       -> /nd:networks/network/node/nwt:termination-point/tp-id
    |           +--rw tp-if-type*   identityref
    |           +--rw otsi-rate?    uint16
    +--rw switching-pools
    |  +--rw odu-switching-pools* [switching-pool-number]
    |     +--rw switching-pool-number    uint16
    |     +--rw switching-pool-type?     org-openroadm-switching-pool-types:switching-pool-types
    |     +--rw non-blocking-list* [nbl-number]
    |        +--rw nbl-number                          uint16
    |        +--rw interconnect-bandwidth-unit?        uint32
    |        +--rw capable-interconnect-bandwidth?     uint32
    |        +--rw available-interconnect-bandwidth?   uint32
    |        +--rw tp-list*                            nwt:tp-id
    +--rw xpdr-attributes
       +--rw xpdr-number?   uint16
       +--rw recolor?       boolean
  augment /nd:networks/nd:network/nd:node/nwt:termination-point:
    +--rw tp-supported-interfaces
    |  +--rw supported-interface-capability* [if-cap-type]
    |     +--rw if-cap-type    identityref
    +--rw xpdr-tp-port-connection-attributes
       +--rw rate?                            identityref
       +--rw odtu-tpn-pool* [odtu-type]
       |  +--rw odtu-type    identityref
       |  +--rw tpn-pool*    uint16
       +--rw ts-pool*                         uint16
       +--rw opucn-ts-pool*                   org-openroadm-otn-common-types:opucn-trib-slot-def
       +--rw wavelength
       |  +--rw frequency?   org-openroadm-common-optical-channel-types:frequency-THz
       |  +--rw width?       org-openroadm-common-optical-channel-types:frequency-GHz
       +--rw tail-equipment?                  string
       +--rw tail-equipment-id?               string
       +--rw tail-clfi?                       string
       +--rw tp-id?                           nwt:tp-id
       +--rw network-ref?                     -> /nd:networks/network/network-id
       +--rw node-ref?                        -> /nd:networks/network[nd:network-id=current()/../network-ref]/node/node-id
       +--rw supported-client-services
       |  +--rw supported-client-service* [service-format]
       |     +--rw service-format                   org-openroadm-service-format:service-format
       |     +--rw service-rate*                    uint32
       |     +--rw other-service-format-and-rate*   string
       +--rw service-format?                  org-openroadm-service-format:service-format
       +--rw service-rate?                    uint32
       +--rw other-service-format-and-rate?   string
  augment /nd:networks/nd:network/nwt:link:
    +--rw available-bandwidth?   uint32
    +--rw used-bandwidth?        uint32
    +--rw ODU-protected?         boolean

module: org-openroadm-pm
  +--ro current-pm-list
  |  +--ro current-pm-entry* [pm-resource-type pm-resource-type-extension pm-resource-instance]
  |     +--ro pm-resource-instance          instance-identifier
  |     +--ro pm-resource-type              org-openroadm-resource-types:resource-type-enum
  |     +--ro pm-resource-type-extension    string
  |     +--ro retrieval-time                yang:date-and-time
  |     +--ro current-pm* [type extension location direction]
  |        +--ro type           pm-names-enum
  |        +--ro extension      string
  |        +--ro location       org-openroadm-common-alarm-pm-types:location
  |        +--ro direction      org-openroadm-common-alarm-pm-types:direction
  |        +--ro measurement* [granularity]
  |           +--ro granularity         org-openroadm-pm-types:pm-granularity
  |           +--ro pmParameterValue    pm-data-type
  |           +--ro pmParameterUnit?    string
  |           +--ro validity            validity
  |           +--ro start-time          yang:date-and-time
  +--ro historical-pm-list {historical-pm-retrieval}?
     +--ro historical-pm-entry* [pm-resource-type pm-resource-type-extension pm-resource-instance]
        +--ro pm-resource-instance          instance-identifier
        +--ro pm-resource-type              org-openroadm-resource-types:resource-type-enum
        +--ro pm-resource-type-extension    string
        +--ro historical-pm* [type extension location direction]
           +--ro type           pm-names-enum
           +--ro extension      string
           +--ro location       org-openroadm-common-alarm-pm-types:location
           +--ro direction      org-openroadm-common-alarm-pm-types:direction
           +--ro measurement* [granularity bin-number]
              +--ro granularity         org-openroadm-pm-types:pm-granularity
              +--ro bin-number          uint16
              +--ro pmParameterValue    pm-data-type
              +--ro pmParameterUnit?    string
              +--ro validity            validity
              +--ro completion-time     yang:date-and-time

  rpcs:
    +---x clear-pm
    |  +---w input
    |  |  +---w device
    |  |  |  +---w node-id?   org-openroadm-common-node-types:node-id-type
    |  |  +---w resource
    |  |  |  +---w (resource)?
    |  |  |     +--:(circuit-pack)
    |  |  |     |  +---w circuit-pack-name         string
    |  |  |     +--:(port)
    |  |  |     |  +---w port
    |  |  |     |     +---w circuit-pack-name    string
    |  |  |     |     +---w port-name?           string
    |  |  |     +--:(connection)
    |  |  |     |  +---w connection-name           string
    |  |  |     +--:(physical-link)
    |  |  |     |  +---w physical-link-name        string
    |  |  |     +--:(internal-link)
    |  |  |     |  +---w internal-link-name        string
    |  |  |     +--:(shelf)
    |  |  |     |  +---w shelf-name                string
    |  |  |     +--:(srg)
    |  |  |     |  +---w srg-number                uint16
    |  |  |     +--:(degree)
    |  |  |     |  +---w degree-number             uint16
    |  |  |     +--:(service)
    |  |  |     |  +---w service-name              string
    |  |  |     +--:(interface)
    |  |  |     |  +---w interface-name            string
    |  |  |     +--:(odu-sncp-pg)
    |  |  |     |  +---w odu-sncp-pg-name          string
    |  |  |     +--:(client-sncp-pg)
    |  |  |     |  +---w client-sncp-pg-name       string
    |  |  |     +--:(circuit-pack-pg)
    |  |  |     |  +---w circuit-pack-pg-name      string
    |  |  |     +--:(other)
    |  |  |     |  +---w other-resource-id         string
    |  |  |     +--:(device)
    |  |  |     |  +---w node-id                   org-openroadm-common-node-types:node-id-type
    |  |  |     +--:(line-amplifier)
    |  |  |     |  +---w amp-number                uint8
    |  |  |     +--:(xponder)
    |  |  |     |  +---w xpdr-number               uint16
    |  |  |     +--:(versioned-service)
    |  |  |     |  +---w versioned-service-name    string
    |  |  |     |  +---w version-number            uint64
    |  |  |     +--:(temp-service)
    |  |  |        +---w common-id                 string
    |  |  +---w resourceType
    |  |  |  +---w type         resource-type-enum
    |  |  |  +---w extension?   string
    |  |  +---w pm-type?        enumeration
    |  |  +---w granularity?    org-openroadm-pm-types:pm-granularity
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x collect-historical-pm-file
       +---w input
       |  +---w from-bin-number?   uint16
       |  +---w to-bin-number?     uint16
       |  +---w granularity?       org-openroadm-pm-types:pm-granularity
       +--ro output
          +--ro pm-filename       string
          +--ro status            rpc-status
          +--ro status-message?   string

  notifications:
    +---n historical-pm-collect-result
       +--ro pm-filename       string
       +--ro status            rpc-status
       +--ro status-message?   string

module: org-openroadm-prot-equipment-aps

  rpcs:
    +---x circuit-pack-protection-switch
       +---w input
       |  +---w circuit-pack-pg-name     -> /org-openroadm-device:org-openroadm-device/protection-grps/org-openroadm-prot-equipment-aps:circuit-pack-pg/name
       |  +---w cp-pg-descriptor-name    -> /org-openroadm-device:org-openroadm-device/protection-grps/org-openroadm-prot-equipment-aps:circuit-pack-pg[name=current()/../circuit-pack-pg-name]/cp-pg-descriptor/name
       |  +---w switch-command           enumeration
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

module: org-openroadm-prot-otn-linear-aps

  rpcs:
    +---x odu-sncp-protection-switch
    |  +---w input
    |  |  +---w protection-group    -> /org-openroadm-device:org-openroadm-device/protection-grps/org-openroadm-prot-otn-linear-aps:odu-sncp-pg/name
    |  |  +---w pg-interface        -> /org-openroadm-device:org-openroadm-device/interface/name
    |  |  +---w switch-command?     enumeration
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x client-sncp-protection-switch
       +---w input
       |  +---w protection-group    -> /org-openroadm-device:org-openroadm-device/protection-grps/org-openroadm-prot-otn-linear-aps:client-sncp-pg/name
       |  +---w pg-interface        -> /org-openroadm-device:org-openroadm-device/interface/name
       |  +---w switch-command?     enumeration
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

  notifications:
    +---n odu-sncp-pg-switch-event
       +--ro switch-status?      enumeration
       +--ro odu-sncp-pg-name?   string

module: org-openroadm-rstp

  notifications:
    +---n rstp-topology-change
    |  +--ro node-id?   org-openroadm-common-node-types:node-id-type
    +---n rstp-new-root
       +--ro node-id?   org-openroadm-common-node-types:node-id-type

