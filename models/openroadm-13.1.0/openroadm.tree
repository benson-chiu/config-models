  rpcs:
    +---x led-control
    |  +---w input
    |  |  +---w (equipment-entity)
    |  |  |  +--:(shelf)
    |  |  |  |  +---w shelf-name           -> /org-openroadm-device/shelves/shelf-name
    |  |  |  +--:(circuit-pack)
    |  |  |     +---w circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |  |  +---w enabled                    boolean
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x create-tech-info
    |  +---w input
    |  |  +---w shelf-id?     -> /org-openroadm-device/shelves/shelf-name
    |  |  +---w log-option?   string
    |  +--ro output
    |     +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |     +--ro log-file-name?    string
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x get-connection-port-trail
    |  +---w input
    |  |  +---w connection-name    string
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    |     +--ro ports* []
    |        +--ro rack?                string
    |        +--ro shelf?               string
    |        +--ro slot?                string
    |        +--ro subSlot?             string
    |        +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |        +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
    |        +--ro is-physical          boolean
    |        +--ro pm-capable           boolean
    |        +--ro alarm-capable        boolean
    +---x get-connection-port-trail-optical-pm
    |  +---w input
    |  |  +---w connection-name    string
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    |     +--ro port* [circuit-pack-name port-name]
    |     |  +--ro circuit-pack-name          -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |     |  +--ro port-name                  -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
    |     |  +--ro is-physical                boolean
    |     |  +--ro is-aggregate-or-channel    enumeration
    |     |  +--ro pm-retrieval-time          ietf-yang-types:date-and-time
    |     |  +--ro pm-data* []
    |     |     +--ro type                pm-names-enum
    |     |     +--ro extension?          string
    |     |     +--ro location            org-openroadm-common-alarm-pm-types:location
    |     |     +--ro direction           org-openroadm-common-alarm-pm-types:direction
    |     |     +--ro pmParameterValue    pm-data-type
    |     |     +--ro pmParameterUnit?    string
    |     |     +--ro validity            validity
    |     |     +--ro start-time          ietf-yang-types:date-and-time
    |     +--ro interface* [interface-name]
    |        +--ro interface-name       -> /org-openroadm-device/interface/name
    |        +--ro type                 identityref
    |        +--ro pm-retrieval-time    ietf-yang-types:date-and-time
    |        +--ro pm-data* []
    |           +--ro type                pm-names-enum
    |           +--ro extension?          string
    |           +--ro location            org-openroadm-common-alarm-pm-types:location
    |           +--ro direction           org-openroadm-common-alarm-pm-types:direction
    |           +--ro pmParameterValue    pm-data-type
    |           +--ro pmParameterUnit?    string
    |           +--ro validity            validity
    |           +--ro start-time          ietf-yang-types:date-and-time
    +---x disable-automatic-shutoff
    |  +---w input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number       -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w support-timer?         uint16
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x start-scan
    |  +---w input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number       -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w port-direction?        org-openroadm-common-alarm-pm-types:direction
    |  |  +---w distance?              decimal64
    |  |  +---w resolution?            decimal64
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x set-current-datetime
    |  +---w input
    |  |  +---w current-datetime    ietf-yang-types:date-and-time
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x clear-recovery-mode {recovery-mode-support}?
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

  notifications:
    +---n create-tech-info-notification
    |  +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |  +--ro log-file-name?    string
    |  +--ro status            rpc-status
    |  +--ro status-message?   string
    +---n otdr-scan-result
    |  +--ro status            rpc-status
    |  +--ro status-message?   string
    |  +--ro result-file?      string
    +---n change-notification
       +--ro change-time?   ietf-yang-types:date-and-time
       +--ro changed-by
       |  +--ro (server-or-user)?
       |     +--:(server)
       |     |  +--ro server?        empty
       |     +--:(by-user)
       |        +--ro username       org-openroadm-user-mgmt:username-type
       |        +--ro session-id     ietf-nc:session-id-or-zero-type
       |        +--ro source-host?   ietf-inet-types:ip-address
       +--ro datastore?     enumeration
       +--ro edit* []
          +--ro target?      instance-identifier
          +--ro operation?   ietf-nc:edit-operation-type

module: org-openroadm-file-transfer

  rpcs:
    +---x transfer
    |  +---w input
    |  |  +---w action              enumeration
    |  |  +---w local-file-path     string
    |  |  +---w remote-file-path    inet:uri
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x show-file
    |  +---w input
    |  |  +---w filename?   string
    |  +--ro output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    |     +--ro file* [filename]
    |        +--ro filename         string
    |        +--ro file-size        uint64
    |        +--ro modified-date    ietf-yang-types:date-and-time
    +---x delete-file
       +---w input
       |  +---w filename    string
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

  notifications:
    +---n transfer-notification
       +--ro local-file-path?   string
       +--ro status             extended-rpc-status
       +--ro status-message?    string
       +--ro progress
          +--ro bytes-transferred?     uint64
          +--ro percentage-complete?   uint8

module: org-openroadm-fwdl

  rpcs:
    +---x fw-update
       +---w input
       |  +---w circuit-pack-name?   string
       |  +---w boot?                boolean
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

module: org-openroadm-key-chain
  +--rw key-chains
  |  +--rw key-chain-list* [name]
  |     +--rw name               string
  |     +--rw key-chain-entry* [key-id]
  |        +--rw key-id              uint64
  |        +--rw key-string
  |        |  +--rw (key-string-style)?
  |        |     +--:(keystring)
  |        |     |  +--rw keystring?   string
  |        |     +--:(hexadecimal) {hex-key-string}?
  |        +--rw crypto-algorithm
  |           +--rw (algorithm)?
  |              +--:(md5)
  |                 +--rw md5?   empty
  +--ro key-chains-state
     +--ro key-chain-list-state* []
        +--ro name-state?        string
        +--ro key-chain-entry* [key-id]
           +--ro key-id                    uint64
           +--ro crypto-algorithm-state
              +--ro (algorithm)?
                 +--:(md5)
                    +--ro md5?   empty

