       |  |     +---w preemption?             boolean
       |  |     +---w restoration-priority?   uint8
       |  +---w failure-case-list
       |     +---w failure-case* [failure-case-id]
       |        +---w failure-case-id    uint32
       |        +---w failure-type?      enumeration
       |        +---w nodes*             string
       |        +---w logical-links*     string
       |        +---w physical-links*    string
       +--ro output
          +--ro configuration-response-common
          |  +--ro request-id             string
          |  +--ro response-code          string
          |  +--ro response-message?      string
          |  +--ro ack-final-indicator    string
          +--ro unsupported-customization-options*   string

module: org-openroadm-database

  rpcs:
    +---x db-backup
    |  +---w input
    |  |  +---w filename?   string
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x db-restore
    |  +---w input
    |  |  +---w filename?      string
    |  |  +---w nodeIDCheck?   boolean
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x db-activate
    |  +---w input
    |  |  +---w rollBackTimer?   string
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x cancel-rollback-timer
    |  +---w input
    |  |  +---w accept?   boolean
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x database-init
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

  notifications:
    +---n db-backup-notification
    |  +--ro status            rpc-status
    |  +--ro status-message?   string
    +---n db-restore-notification
    |  +--ro status            rpc-status
    |  +--ro status-message?   string
    +---n db-activate-notification
       +--ro db-active-notification-type?   org-openroadm-common-types:activate-notification-type
       +--ro status                         rpc-status
       +--ro status-message?                string

module: org-openroadm-de-operations

  rpcs:
    +---x restart
       +---w input
       |  +---w device
       |  |  +---w node-id?   org-openroadm-common-node-types:node-id-type
       |  +---w resource
       |  |  +---w (resource)?
       |  |     +--:(circuit-pack)
       |  |     |  +---w circuit-pack-name         string
       |  |     +--:(port)
       |  |     |  +---w port
       |  |     |     +---w circuit-pack-name    string
       |  |     |     +---w port-name?           string
       |  |     +--:(connection)
       |  |     |  +---w connection-name           string
       |  |     +--:(physical-link)
       |  |     |  +---w physical-link-name        string
       |  |     +--:(internal-link)
       |  |     |  +---w internal-link-name        string
       |  |     +--:(shelf)
       |  |     |  +---w shelf-name                string
       |  |     +--:(srg)
       |  |     |  +---w srg-number                uint16
       |  |     +--:(degree)
       |  |     |  +---w degree-number             uint16
       |  |     +--:(service)
       |  |     |  +---w service-name              string
       |  |     +--:(interface)
       |  |     |  +---w interface-name            string
       |  |     +--:(odu-sncp-pg)
       |  |     |  +---w odu-sncp-pg-name          string
       |  |     +--:(client-sncp-pg)
       |  |     |  +---w client-sncp-pg-name       string
       |  |     +--:(circuit-pack-pg)
       |  |     |  +---w circuit-pack-pg-name      string
       |  |     +--:(other)
       |  |     |  +---w other-resource-id         string
       |  |     +--:(device)
       |  |     |  +---w node-id                   org-openroadm-common-node-types:node-id-type
       |  |     +--:(line-amplifier)
       |  |     |  +---w amp-number                uint8
       |  |     +--:(xponder)
       |  |     |  +---w xpdr-number               uint16
       |  |     +--:(versioned-service)
       |  |     |  +---w versioned-service-name    string
       |  |     |  +---w version-number            uint64
       |  |     +--:(temp-service)
       |  |        +---w common-id                 string
       |  +---w resourceType
       |  |  +---w type         resource-type-enum
       |  |  +---w extension?   string
       |  +---w option?         enumeration
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

  notifications:
    +---n restart-notification
       +--ro device
       |  +--ro node-id?   org-openroadm-common-node-types:node-id-type
       +--ro resource
       |  +--ro (resource)?
       |     +--:(circuit-pack)
       |     |  +--ro circuit-pack-name         string
       |     +--:(port)
       |     |  +--ro port
       |     |     +--ro circuit-pack-name    string
       |     |     +--ro port-name?           string
       |     +--:(connection)
       |     |  +--ro connection-name           string
       |     +--:(physical-link)
       |     |  +--ro physical-link-name        string
       |     +--:(internal-link)
       |     |  +--ro internal-link-name        string
       |     +--:(shelf)
       |     |  +--ro shelf-name                string
       |     +--:(srg)
       |     |  +--ro srg-number                uint16
       |     +--:(degree)
       |     |  +--ro degree-number             uint16
       |     +--:(service)
       |     |  +--ro service-name              string
       |     +--:(interface)
       |     |  +--ro interface-name            string
       |     +--:(odu-sncp-pg)
       |     |  +--ro odu-sncp-pg-name          string
       |     +--:(client-sncp-pg)
       |     |  +--ro client-sncp-pg-name       string
       |     +--:(circuit-pack-pg)
       |     |  +--ro circuit-pack-pg-name      string
       |     +--:(other)
       |     |  +--ro other-resource-id         string
       |     +--:(device)
       |     |  +--ro node-id                   org-openroadm-common-node-types:node-id-type
       |     +--:(line-amplifier)
       |     |  +--ro amp-number                uint8
       |     +--:(xponder)
       |     |  +--ro xpdr-number               uint16
       |     +--:(versioned-service)
       |     |  +--ro versioned-service-name    string
       |     |  +--ro version-number            uint64
       |     +--:(temp-service)
       |        +--ro common-id                 string
       +--ro resourceType
          +--ro type         resource-type-enum
          +--ro extension?   string

module: org-openroadm-device
  +--rw org-openroadm-device
     +--rw info
