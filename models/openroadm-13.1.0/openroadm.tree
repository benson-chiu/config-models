module: org-openroadm-alarm
  +--ro active-alarm-list
     +--ro activeAlarms* [id]
        +--ro id                   string
        +--ro resource
        |  +--ro device
        |  |  +--ro node-id?   org-openroadm-common-node-types:node-id-type
        |  +--ro resource
        |  |  +--ro (resource)?
        |  |     +--:(circuit-pack)
        |  |     |  +--ro circuit-pack-name         string
        |  |     +--:(port)
        |  |     |  +--ro port
        |  |     |     +--ro circuit-pack-name    string
        |  |     |     +--ro port-name?           string
        |  |     +--:(connection)
        |  |     |  +--ro connection-name           string
        |  |     +--:(physical-link)
        |  |     |  +--ro physical-link-name        string
        |  |     +--:(internal-link)
        |  |     |  +--ro internal-link-name        string
        |  |     +--:(shelf)
        |  |     |  +--ro shelf-name                string
        |  |     +--:(srg)
        |  |     |  +--ro srg-number                uint16
        |  |     +--:(degree)
        |  |     |  +--ro degree-number             uint16
        |  |     +--:(service)
        |  |     |  +--ro service-name              string
        |  |     +--:(interface)
        |  |     |  +--ro interface-name            string
        |  |     +--:(odu-sncp-pg)
        |  |     |  +--ro odu-sncp-pg-name          string
        |  |     +--:(client-sncp-pg)
        |  |     |  +--ro client-sncp-pg-name       string
        |  |     +--:(circuit-pack-pg)
        |  |     |  +--ro circuit-pack-pg-name      string
        |  |     +--:(other)
        |  |     |  +--ro other-resource-id         string
        |  |     +--:(device)
        |  |     |  +--ro node-id                   org-openroadm-common-node-types:node-id-type
        |  |     +--:(line-amplifier)
        |  |     |  +--ro amp-number                uint8
        |  |     +--:(xponder)
        |  |     |  +--ro xpdr-number               uint16
        |  |     +--:(versioned-service)
        |  |     |  +--ro versioned-service-name    string
        |  |     |  +--ro version-number            uint64
        |  |     +--:(temp-service)
        |  |        +--ro common-id                 string
        |  +--ro resourceType
        |     +--ro type         resource-type-enum
        |     +--ro extension?   string
        +--ro probableCause
        |  +--ro cause        probable-cause-enum
        |  +--ro extension?   string
        |  +--ro direction    org-openroadm-common-alarm-pm-types:direction
        |  +--ro location     org-openroadm-common-alarm-pm-types:location
        |  +--ro type?        enumeration
        +--ro raiseTime            yang:date-and-time
        +--ro severity             severity
        +--ro circuit-id?          string
        +--ro additional-detail?   string
        +--ro corrective-action?   string

  notifications:
    +---n alarm-notification
       +--ro id                   string
       +--ro resource
       |  +--ro device
       |  |  +--ro node-id?   org-openroadm-common-node-types:node-id-type
       |  +--ro resource
       |  |  +--ro (resource)?
       |  |     +--:(circuit-pack)
       |  |     |  +--ro circuit-pack-name         string
       |  |     +--:(port)
       |  |     |  +--ro port
       |  |     |     +--ro circuit-pack-name    string
       |  |     |     +--ro port-name?           string
       |  |     +--:(connection)
       |  |     |  +--ro connection-name           string
       |  |     +--:(physical-link)
       |  |     |  +--ro physical-link-name        string
       |  |     +--:(internal-link)
       |  |     |  +--ro internal-link-name        string
       |  |     +--:(shelf)
       |  |     |  +--ro shelf-name                string
       |  |     +--:(srg)
       |  |     |  +--ro srg-number                uint16
       |  |     +--:(degree)
       |  |     |  +--ro degree-number             uint16
       |  |     +--:(service)
       |  |     |  +--ro service-name              string
       |  |     +--:(interface)
       |  |     |  +--ro interface-name            string
       |  |     +--:(odu-sncp-pg)
       |  |     |  +--ro odu-sncp-pg-name          string
       |  |     +--:(client-sncp-pg)
       |  |     |  +--ro client-sncp-pg-name       string
       |  |     +--:(circuit-pack-pg)
       |  |     |  +--ro circuit-pack-pg-name      string
       |  |     +--:(other)
       |  |     |  +--ro other-resource-id         string
       |  |     +--:(device)
       |  |     |  +--ro node-id                   org-openroadm-common-node-types:node-id-type
       |  |     +--:(line-amplifier)
       |  |     |  +--ro amp-number                uint8
       |  |     +--:(xponder)
       |  |     |  +--ro xpdr-number               uint16
       |  |     +--:(versioned-service)
       |  |     |  +--ro versioned-service-name    string
       |  |     |  +--ro version-number            uint64
       |  |     +--:(temp-service)
       |  |        +--ro common-id                 string
       |  +--ro resourceType
       |     +--ro type         resource-type-enum
       |     +--ro extension?   string
       +--ro probableCause
       |  +--ro cause        probable-cause-enum
       |  +--ro extension?   string
       |  +--ro direction    org-openroadm-common-alarm-pm-types:direction
       |  +--ro location     org-openroadm-common-alarm-pm-types:location
       |  +--ro type?        enumeration
       +--ro raiseTime            yang:date-and-time
       +--ro severity             severity
       +--ro circuit-id?          string
       +--ro additional-detail?   string
       +--ro corrective-action?   string

module: org-openroadm-ber-test

  rpcs:
    +---x ber-test
    |  +---w input
    |  |  +---w sdnc-request-header
    |  |  |  +---w request-id?          string
    |  |  |  +---w rpc-action?          rpc-actions
    |  |  |  +---w notification-url?    string
    |  |  |  +---w request-system-id?   string
    |  |  +---w service-name           string
    |  |  +---w ber-options
    |  |     +---w target-prefec-ber?    decimal64
    |  |     +---w duration?             uint16
    |  |     +---w pm-polling-timeout?   uint16
    |  |     +---w retry-attempts?       uint16
    |  +--ro output
    |     +--ro configuration-response-common
    |        +--ro request-id             string
    |        +--ro response-code          string
    |        +--ro response-message?      string
    |        +--ro ack-final-indicator    string
    +---x complex-ber-test
    |  +---w input
    |  |  +---w sdnc-request-header
    |  |  |  +---w request-id?          string
    |  |  |  +---w rpc-action?          rpc-actions
    |  |  |  +---w notification-url?    string
    |  |  |  +---w request-system-id?   string
    |  |  +---w service-name           string
    |  |  +---w complex-ber-options
    |  |     +---w ber-options
    |  |     |  +---w target-prefec-ber?    decimal64
    |  |     |  +---w duration?             uint16
    |  |     |  +---w pm-polling-timeout?   uint16
    |  |     |  +---w retry-attempts?       uint16
    |  |     +---w is-complex-result?   boolean
    |  +--ro output
    |     +--ro configuration-response-common
    |        +--ro request-id             string
    |        +--ro response-code          string
    |        +--ro response-message?      string
    |        +--ro ack-final-indicator    string
    +---x service-rpc-ber-test-async-callback
    |  +---w input
    |  |  +---w configuration-response-common
    |  |  |  +---w request-id             string
    |  |  |  +---w response-code          string
    |  |  |  +---w response-message?      string
    |  |  |  +---w ack-final-indicator    string
    |  |  +---w service-identifiers
    |  |  |  +---w service-name?     string
    |  |  |  +---w common-id?        string
    |  |  |  +---w version-number?   uint64
    |  |  +---w rpc-timestamp?                   yang:date-and-time
    |  |  +---w timestamp?                       yang:date-and-time
    |  |  +---w ber-results
    |  |     +---w ber-options
    |  |     |  +---w target-prefec-ber?    decimal64
    |  |     |  +---w duration?             uint16
    |  |     |  +---w pm-polling-timeout?   uint16
    |  |     |  +---w retry-attempts?       uint16
    |  |     +---w line-rate?               uint64
    |  |     +---w a-end-ber-measurement
    |  |     |  +---w ber-passed?            boolean
    |  |     |  +---w target-prefec-ber?     decimal64
    |  |     |  +---w measured-prefec-ber?   decimal64
    |  |     +---w z-end-ber-measurement
    |  |        +---w ber-passed?            boolean
    |  |        +---w target-prefec-ber?     decimal64
    |  |        +---w measured-prefec-ber?   decimal64
    |  +--ro output
    |     +--ro configuration-response-common
    |        +--ro request-id             string
    |        +--ro response-code          string
    |        +--ro response-message?      string
    |        +--ro ack-final-indicator    string
    +---x complex-service-rpc-ber-test-async-callback
       +---w input
       |  +---w configuration-response-common
       |  |  +---w request-id             string
       |  |  +---w response-code          string
       |  |  +---w response-message?      string
       |  |  +---w ack-final-indicator    string
       |  +---w service-identifiers
       |  |  +---w service-name?     string
       |  |  +---w common-id?        string
       |  |  +---w version-number?   uint64
       |  +---w rpc-timestamp?                   yang:date-and-time
       |  +---w timestamp?                       yang:date-and-time
       |  +---w ber-results
       |     +---w ber-options
       |     |  +---w target-prefec-ber?    decimal64
       |     |  +---w duration?             uint16
       |     |  +---w pm-polling-timeout?   uint16
       |     |  +---w retry-attempts?       uint16
       |     +---w ber-test-result-details
       |        +---w supporting-service-details* [index]
       |           +---w index                    uint16
       |           +---w service-identifiers
       |           |  +---w service-name?     string
       |           |  +---w common-id?        string
       |           |  +---w version-number?   uint64
       |           +---w service-a-end
       |           |  +---w service-endpoint-details
       |           |     +---w clli            string
       |           |     +---w node-id?        org-openroadm-common-node-types:node-id-type
       |           |     +---w tx-direction
       |           |     |  +---w port
       |           |     |     +---w port-device-name?         string
       |           |     |     +---w port-circuit-pack-name?   string
       |           |     |     +---w port-circuit-pack-type?   string
       |           |     |     +---w port-type?                string
       |           |     |     +---w port-name?                string
       |           |     |     +---w port-rack?                string
       |           |     |     +---w port-shelf?               string
       |           |     |     +---w port-slot?                string
       |           |     |     +---w port-sub-slot?            string
       |           |     +---w rx-direction
       |           |        +---w port
       |           |           +---w port-device-name?         string
       |           |           +---w port-circuit-pack-name?   string
       |           |           +---w port-circuit-pack-type?   string
       |           |           +---w port-type?                string
       |           |           +---w port-name?                string
       |           |           +---w port-rack?                string
       |           |           +---w port-shelf?               string
       |           |           +---w port-slot?                string
       |           |           +---w port-sub-slot?            string
       |           +---w service-z-end
       |           |  +---w service-endpoint-details
       |           |     +---w clli            string
       |           |     +---w node-id?        org-openroadm-common-node-types:node-id-type
       |           |     +---w tx-direction
       |           |     |  +---w port
       |           |     |     +---w port-device-name?         string
       |           |     |     +---w port-circuit-pack-name?   string
       |           |     |     +---w port-circuit-pack-type?   string
       |           |     |     +---w port-type?                string
       |           |     |     +---w port-name?                string
       |           |     |     +---w port-rack?                string
       |           |     |     +---w port-shelf?               string
       |           |     |     +---w port-slot?                string
       |           |     |     +---w port-sub-slot?            string
       |           |     +---w rx-direction
       |           |        +---w port
       |           |           +---w port-device-name?         string
       |           |           +---w port-circuit-pack-name?   string
       |           |           +---w port-circuit-pack-type?   string
       |           |           +---w port-type?                string
       |           |           +---w port-name?                string
       |           |           +---w port-rack?                string
       |           |           +---w port-shelf?               string
       |           |           +---w port-slot?                string
       |           |           +---w port-sub-slot?            string
       |           +---w line-rate?               uint64
       |           +---w a-end-ber-measurement
       |           |  +---w ber-passed?            boolean
       |           |  +---w target-prefec-ber?     decimal64
       |           |  +---w measured-prefec-ber?   decimal64
       |           +---w z-end-ber-measurement
       |              +---w ber-passed?            boolean
       |              +---w target-prefec-ber?     decimal64
       |              +---w measured-prefec-ber?   decimal64
       +--ro output
          +--ro configuration-response-common
             +--ro request-id             string
             +--ro response-code          string
             +--ro response-message?      string
             +--ro ack-final-indicator    string

  notifications:
    +---n service-notification-ber-test
    |  +--ro configuration-response-common
    |  |  +--ro request-id             string
    |  |  +--ro response-code          string
    |  |  +--ro response-message?      string
    |  |  +--ro ack-final-indicator    string
    |  +--ro service-identifiers
    |  |  +--ro service-name?     string
    |  |  +--ro common-id?        string
    |  |  +--ro version-number?   uint64
    |  +--ro rpc-timestamp?                   yang:date-and-time
    |  +--ro timestamp?                       yang:date-and-time
    |  +--ro ber-results
    |     +--ro ber-options
    |     |  +--ro target-prefec-ber?    decimal64
    |     |  +--ro duration?             uint16
    |     |  +--ro pm-polling-timeout?   uint16
    |     |  +--ro retry-attempts?       uint16
    |     +--ro line-rate?               uint64
    |     +--ro a-end-ber-measurement
    |     |  +--ro ber-passed?            boolean
    |     |  +--ro target-prefec-ber?     decimal64
    |     |  +--ro measured-prefec-ber?   decimal64
    |     +--ro z-end-ber-measurement
    |        +--ro ber-passed?            boolean
    |        +--ro target-prefec-ber?     decimal64
    |        +--ro measured-prefec-ber?   decimal64
    +---n complex-service-notification-ber-test
       +--ro configuration-response-common
       |  +--ro request-id             string
       |  +--ro response-code          string
       |  +--ro response-message?      string
       |  +--ro ack-final-indicator    string
       +--ro service-identifiers
       |  +--ro service-name?     string
       |  +--ro common-id?        string
       |  +--ro version-number?   uint64
       +--ro rpc-timestamp?                   yang:date-and-time
       +--ro timestamp?                       yang:date-and-time
       +--ro ber-test-result-details
          +--ro supporting-service-details* [index]
             +--ro index                    uint16
             +--ro service-identifiers
             |  +--ro service-name?     string
             |  +--ro common-id?        string
             |  +--ro version-number?   uint64
             +--ro service-a-end
             |  +--ro service-endpoint-details
             |     +--ro clli            string
             |     +--ro node-id?        org-openroadm-common-node-types:node-id-type
             |     +--ro tx-direction
             |     |  +--ro port
             |     |     +--ro port-device-name?         string
             |     |     +--ro port-circuit-pack-name?   string
             |     |     +--ro port-circuit-pack-type?   string
             |     |     +--ro port-type?                string
             |     |     +--ro port-name?                string
             |     |     +--ro port-rack?                string
             |     |     +--ro port-shelf?               string
             |     |     +--ro port-slot?                string
             |     |     +--ro port-sub-slot?            string
             |     +--ro rx-direction
             |        +--ro port
             |           +--ro port-device-name?         string
             |           +--ro port-circuit-pack-name?   string
             |           +--ro port-circuit-pack-type?   string
             |           +--ro port-type?                string
             |           +--ro port-name?                string
             |           +--ro port-rack?                string
             |           +--ro port-shelf?               string
             |           +--ro port-slot?                string
             |           +--ro port-sub-slot?            string
             +--ro service-z-end
             |  +--ro service-endpoint-details
             |     +--ro clli            string
             |     +--ro node-id?        org-openroadm-common-node-types:node-id-type
             |     +--ro tx-direction
             |     |  +--ro port
             |     |     +--ro port-device-name?         string
             |     |     +--ro port-circuit-pack-name?   string
             |     |     +--ro port-circuit-pack-type?   string
             |     |     +--ro port-type?                string
             |     |     +--ro port-name?                string
             |     |     +--ro port-rack?                string
             |     |     +--ro port-shelf?               string
             |     |     +--ro port-slot?                string
             |     |     +--ro port-sub-slot?            string
             |     +--ro rx-direction
             |        +--ro port
             |           +--ro port-device-name?         string
